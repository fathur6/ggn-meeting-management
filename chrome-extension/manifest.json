{
  "manifest_version": 3,
  "name": "JKPS eMeeting Attendance Sync",
  "version": "1.2.0",
  "description": "Sends the authenticated eMeeting attendance table to the UGS quorum dashboard.",
  "permissions": [],
  "host_permissions": [
    "https://portal.unisza.edu.my/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://portal.unisza.edu.my/sistem/modules.php?name=emeeting*"],
      "js": ["config.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "JKPS eMeeting Attendance Sync" }
}
